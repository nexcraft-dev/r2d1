---
import DocsOverviewPage from "../../../components/DocsOverviewPage.astro";
import { locales, type Locale } from "../../../i18n/config";

export function getStaticPaths() {
  return locales
    .filter((locale) => locale !== "en")
    .map((locale) => ({ params: { locale }, props: { locale } }));
}

const { locale } = Astro.props as { locale: Locale };
---

<DocsOverviewPage locale={locale} />
