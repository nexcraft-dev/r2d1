---
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { localeHreflangs, localePath, locales, type Locale, stripLocale } from "../i18n/config";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  locale?: Locale;
}

const { title, description, noindex = false, locale = "en" } = Astro.props;
const basePath = stripLocale(Astro.url.pathname);
const canonical = new URL(
  localePath(basePath, locale),
  Astro.site ?? "https://r2d1.nexcraft.dev"
).href;
---

<!doctype html>
<html lang={localeHreflangs[locale]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {locales.map((alternateLocale) => (
      <link
        rel="alternate"
        hreflang={localeHreflangs[alternateLocale]}
        href={new URL(localePath(basePath, alternateLocale), Astro.site ?? "https://r2d1.nexcraft.dev").href}
      />
    ))}
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(localePath(basePath, "en"), Astro.site ?? "https://r2d1.nexcraft.dev").href}
    />
    <link rel="icon" type="image/png" href="/r2d1-logo.png" />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="R2D1" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://r2d1.nexcraft.dev/r2d1-logo.png" />
    <meta name="twitter:card" content="summary" />
    <title>{title}</title>
  </head>
  <body>
    <div class="site-frame">
      <div class="site-page">
        <SiteHeader locale={locale} />
        <main id="main-content">
          <slot />
        </main>
        <SiteFooter locale={locale} />
      </div>
    </div>
  </body>
</html>
