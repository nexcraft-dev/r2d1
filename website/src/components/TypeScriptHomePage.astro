---
import SiteLayout from "../layouts/SiteLayout.astro";
import { localePath, type Locale } from "../i18n/config";

interface Copy {
  title: string;
  description: string;
  kicker: string;
  start: string;
  repository: string;
  runtimesEyebrow: string;
  runtimesTitle: string;
  runtimesIntro: string;
  nodeTitle: string;
  nodeDescription: string;
  nodeLink: string;
  workersTitle: string;
  workersDescription: string;
  workersLink: string;
  installEyebrow: string;
  installTitle: string;
  installDescription: string;
  compatibilityTitle: string;
  compatibilityDescription: string;
  docsLink: string;
}

