    docsLink: "阅读 TypeScript 指南 →"
  },
  ja: {
    title: "TypeScript 向けのドキュメント保存とインデックス検索。",
    description: "Node.js または Cloudflare Workers で同じ R2D1 コレクション API を使います。R2 は完全なドキュメントを保存し、D1 は再構築できるインデックスを保存します。",
    kicker: "R2D1 / TYPESCRIPT",
    start: "TypeScript ガイドを読む",
    repository: "npm パッケージを見る",
    runtimesEyebrow: "ランタイム対応",
    runtimesTitle: "ランタイムを選びます。",
    runtimesIntro: "パッケージは Node.js と Cloudflare Workers 用の別々の adapter を提供します。",
    nodeTitle: "Node.js 22 以降",
    nodeDescription: "Node.js 用 R2 と D1 adapter を使います。R2 adapter は AWS S3 SDK を使います。",
    nodeLink: "Node.js の設定 →",
    workersTitle: "Cloudflare Workers",
    workersDescription: "Workers の R2 と D1 binding を使います。Core と Workers adapter は Node.js module を import しません。",
    workersLink: "Workers の設定 →",
    installEyebrow: "インストール",
    installTitle: "パッケージを追加します。",
    installDescription: "npm から R2D1 をインストールし、ランタイムに合う adapter を選びます。",
    compatibilityTitle: "互換性のあるストレージ契約。",
    compatibilityDescription: "R2 key、D1 schema、cursor は Java の契約に従います。ドキュメント bytes の形式は codec が決めます。JSON は明示的な選択肢であり、既定の形式ではありません。",
