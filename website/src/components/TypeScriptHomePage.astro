const { locale } = Astro.props as { locale: Locale };
const c = copy[locale];
const installCommand = "npm install @nexcraft-dev/r2d1";
---

<SiteLayout
  title={`R2D1 TypeScript | ${c.title}`}
  description={c.description}
  locale={locale}
  edition="typescript"
>
  <section class="hero" aria-labelledby="typescript-title">
    <div class="hero-copy">
      <p class="hero-kicker">{c.kicker}</p>
      <h1 id="typescript-title">{c.title}</h1>
      <p>{c.description}</p>
      <div class="hero-actions">
        <a class="button-primary" href={localePath("/docs/typescript/", locale)}>{c.start}</a>
        <a class="button-secondary" href="https://www.npmjs.com/package/@nexcraft-dev/r2d1" rel="noreferrer">{c.repository}</a>
      </div>
    </div>
    <div class="hero-mark" aria-label="TypeScript">
      <strong>TS</strong>
      <span>NODE.JS + WORKERS</span>
    </div>
  </section>

  <section class="section" aria-labelledby="runtimes-title">
    <div class="section-eyebrow section-eyebrow-olive">
      <span>{c.runtimesEyebrow}</span>
      <h2 id="runtimes-title">{c.runtimesTitle}</h2>
    </div>
    <p class="section-intro">{c.runtimesIntro}</p>
    <div class="backend-grid">
      <article class="backend-panel backend-document">
        <div class="backend-panel-heading">
          <span>NODE.JS</span>
          <h3>{c.nodeTitle}</h3>
        </div>
        <p>{c.nodeDescription}</p>
        <a class="edition-card-link" href={localePath("/docs/typescript/", locale)}>{c.nodeLink}</a>
      </article>
      <article class="backend-panel backend-index">
        <div class="backend-panel-heading">
          <span>CLOUDFLARE</span>
          <h3>{c.workersTitle}</h3>
        </div>
        <p>{c.workersDescription}</p>
        <a class="edition-card-link" href={localePath("/docs/typescript/", locale)}>{c.workersLink}</a>
      </article>
    </div>
  </section>

  <section class="section" aria-labelledby="install-title">
    <div class="section-eyebrow section-eyebrow-sky">
      <span>{c.installEyebrow}</span>
      <h2 id="install-title">{c.installTitle}</h2>
    </div>
    <p class="section-intro">{c.installDescription}</p>
    <pre class="code-block"><code>{installCommand}</code></pre>
  </section>

  <section class="section" aria-labelledby="compatibility-title">
    <div class="section-eyebrow section-eyebrow-salmon">
      <span>R2D1</span>
      <h2 id="compatibility-title">{c.compatibilityTitle}</h2>
    </div>
    <p class="section-intro">{c.compatibilityDescription}</p>
    <a href={localePath("/docs/typescript/", locale)}>{c.docsLink}</a>
  </section>
</SiteLayout>
