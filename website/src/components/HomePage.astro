interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = copy[locale];
---

<SiteLayout title={c.seoTitle} description={c.seoDescription} locale={locale}>
  <section class="hero" aria-labelledby="home-title">
    <div class="hero-copy">
      <p class="hero-kicker">{c.kicker}</p>
      <h1 id="home-title">{c.title}</h1>
      <p>{c.description}</p>
      <div class="hero-actions">
        <a class="button-primary" href={localePath("/docs/getting-started/", locale)}>{c.primaryCta}</a>
        <a class="button-secondary" href="https://github.com/nexcraft-dev/r2d1" rel="noreferrer">{c.githubCta}</a>
      </div>
    </div>
    <div class="hero-mark" aria-label={c.heroAria}>
      <strong>{c.heroMark}</strong>
      <span>{c.heroMarkSub}</span>
    </div>
  </section>

  <section class="section" aria-labelledby="backends-title">
    <div class="section-eyebrow section-eyebrow-olive">
      <span>{c.backendsEyebrow}</span>
      <h2 id="backends-title">{c.backendsTitle}</h2>
    </div>
    <p class="section-intro">{c.backendsIntro}</p>
    <div class="backend-grid">
      <section class="backend-panel backend-document" aria-labelledby="document-backends-title">
        <div class="backend-panel-heading">
          <span>{c.documentLabel}</span>
          <h3 id="document-backends-title">{c.documentTitle}</h3>
        </div>
        <p>{c.documentDescription}</p>
        <div class="backend-options">
          {c.documentOptions.map((option) => (
            <article class="backend-option">
              <div class="backend-option-heading">
                <h4>{option.name}</h4>
                <span>{option.vendor}</span>
              </div>
              <p>{option.description}</p>
              <a href={localePath(option.href, locale)}>{option.setup}</a>
            </article>
          ))}
        </div>
      </section>

      <section class="backend-panel backend-index" aria-labelledby="index-backends-title">
        <div class="backend-panel-heading">
          <span>{c.indexLabel}</span>
          <h3 id="index-backends-title">{c.indexTitle}</h3>
        </div>
        <p>{c.indexDescription}</p>
        <div class="backend-options">
          {c.indexOptions.map((option) => (
            <article class="backend-option">
              <div class="backend-option-heading">
                <h4>{option.name}</h4>
                <span>{option.vendor}</span>
              </div>
              <p>{option.description}</p>
              <a href={localePath(option.href, locale)}>{option.setup}</a>
            </article>
          ))}
        </div>
      </section>
    </div>
    <aside class="backend-note">
      <strong>{c.pairingStrong}</strong> {c.pairingNote}
    </aside>
  </section>

  <section class="section" aria-labelledby="quick-start-title">
    <div class="section-eyebrow section-eyebrow-sky">
      <span>{c.commonEyebrow}</span>
      <h2 id="quick-start-title">{c.commonTitle}</h2>
    </div>
    <p class="section-intro">{c.commonIntro}</p>
    <pre class="code-block"><code class="language-java">{quickStart}</code></pre>
    <p class="section-intro">
      {c.commonLinkIntro} <a href={localePath("/docs/getting-started/", locale)}>{c.commonLink}</a>.
    </p>
  </section>

  <section class="section" aria-labelledby="modules-title">
    <div class="section-eyebrow section-eyebrow-olive">
      <span>{c.modulesEyebrow}</span>
      <h2 id="modules-title">{c.modulesTitle}</h2>
    </div>
    <p class="section-intro">{c.modulesIntro}</p>
    <div class="module-grid">
      {c.modules.map((module) => (
        <article class:list={{ "module-card": true, [`module-card-${module.name.toLowerCase().replace("r2d1-", "")}`]: true }}>
          <span class="module-label">{module.label}</span>
          <h3>{module.name}</h3>
          <code>{module.coordinate}</code>
          <p>{module.description}</p>
          <a href={localePath(module.href, locale)}>{module.setup}</a>
        </article>
      ))}
    </div>
  </section>

  <section class="section" aria-label={c.ctaTitle}>
    <div class="cta-block">
      <div>
        <h2>{c.ctaTitle}</h2>
        <p>{c.ctaDescription}</p>
      </div>
      <a class="button-secondary" href={localePath("/docs/getting-started/", locale)}>{c.ctaLink}</a>
    </div>
  </section>
</SiteLayout>
