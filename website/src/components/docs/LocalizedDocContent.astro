      sections: [
        { title: "Indexed field のフィルタ", paragraphs: ["where(String) で比較を開始します。field には @Index が必要で、adapter は指定された value type をサポートしなければなりません。"], code: { language: "java", value: queryExample } },
        { title: "比較演算子", table: { headers: ["Method", "意味"], rows: [["eq(value)", "等しい"], ["notEq(value)", "等しくない"], ["gt(value)", "より大きい"], ["gte(value)", "以上"], ["lt(value)", "より小さい"], ["lte(value)", "以下"]] }, paragraphs: ["すべての filter は論理 AND で結合されます。built-in JDBC contract では Boolean field は equality と inequality をサポートし、ordered comparison には ordered value type が必要です。"] },
        { title: "1つの sort", paragraphs: ["sortBy は最大1回だけ呼べます。sort field は indexed でなければならず、明示的な limit は正数にします。"], code: { language: "java", value: `Page<User> page = users.query()
    .where("country").eq("NZ")
    .sortBy("score", SortDirection.DESC)
    .limit(20)
    .fetch();` } },
        { title: "Cursor pagination", paragraphs: ["fetch() は Page<T> を返し、次ページがあるとき nextCursor は non-null です。after(...) を使うときは同じ filter と sort を維持します。cursor は adapter-specific opaque token なので decode や変更をしないでください。"], code: { language: "java", value: cursorExample } },
        { title: "意図した制限", bullets: ["提供しない機能: join、aggregation、arbitrary SQL、OR predicate、全文検索、LIKE、contains、正規表現。", "query に参加する field は document metadata で @Index として宣言します。", "adapter が対応しない type や unindexed field は検証で拒否されます。"] }
      ],
      related: [{ label: "基本概念 →", href: "/docs/concepts/" }, { label: "整合性と復旧 →", href: "/docs/consistency/" }]
    },
    consistency: {
      intro: "R2D1 は2つの store を1つの distributed transaction であるかのように扱いません。DocumentStore は content と logical existence の権威ソースで、IndexStore は再構築可能な materialized projection です。",
      sections: [
        { title: "Mutation の順序", paragraphs: ["2つの mutation path はどちらも authoritative document を先に更新します。これにより authoritative scan だけで復旧できます。"], code: { language: "text", value: consistencyExample } },
        { title: "PartialFailure", paragraphs: ["最初の操作が成功し、2つ目が失敗すると PersistenceException.PartialFailure が発生します。影響を受けた DocumentKey と2段目の元の cause を保持します。自動 rollback、retry、compensating write はありません。", "authoritative delete 後の index cleanup に失敗した場合、get(id) は document absent と報告しますが、stale index row により query が PersistenceException.InconsistentState になることがあります。stale row を黙って無視しません。"] },
        { title: "Index projection の再構築", paragraphs: ["基盤の failure を解決した後、collection で rebuildIndex() を呼びます。authoritative document key を bounded page で列挙し、各 document を読み、metadata から index entry を作り、derived rows だけを置き換えます。"], code: { language: "java", value: rebuildExample } },
        { title: "非アトミックな操作", paragraphs: ["rebuildIndex() は変更されていない collection なら再実行できますが atomic ではありません。rows を clear した後に失敗すると projection が不完全になります。collection への書き込みを止め、failure を解決してから再実行してください。", "この contract は distributed transaction、background repair、automatic retry、concurrent rebuild coordination、lost-update prevention、power-loss durability を提供しません。"] }
      ],
      related: [{ label: "R2 DocumentStore →", href: "/docs/document-stores/r2/" }, { label: "D1 IndexStore →", href: "/docs/index-stores/d1/" }]
    },
