      intro: "r2d1-micronaut は Micronaut-managed resource から framework-neutral R2D1 bean を条件付きで作成する optional integration module です。base r2d1 artifact に Micronaut API は追加しません。",
      sections: [
        { title: "Dependency と runtime", paragraphs: ["Micronaut 5 integration は現在 Java 25 が必要です。core と JDBC artifact は Java 21 向けのままです。JDBC index には r2d1-jdbc とアプリケーションが選ぶ JDBC driver も追加します。"], code: { language: "kotlin", value: `implementation("dev.nexcraft:r2d1-micronaut:${stableVersion}")` } },
        { title: "Integration を有効にする", paragraphs: ["r2d1.enabled=true でなければ integration は無効です。R2D1 を eager に作るため、不完全な設定は startup 中に失敗します。index type は jdbc または d1 です。"], code: { language: "yaml", value: micronautYaml } },
        { title: "Cloudflare 設定", paragraphs: ["r2 と d1 の設定は framework-neutral adapter と同じ境界を使います。secret を含む configuration object は toString() で値を隠します。"], code: { language: "yaml", value: cloudflareYaml } },
        { title: "Resource ownership", paragraphs: ["アプリケーションが unique または @Primary の S3AsyncClient、Java HttpClient を提供すれば integration は借用し、閉じません。なければ integration が作った adapter resource を所有して閉じます。", "r2d1.jdbc.executor がアプリケーション所有の Executor を指す場合、Micronaut は bounded admission で包むだけで終了しません。external executor と execution-mode を同時に設定しないでください。", "integration は DataSource、connection pool、database server を開始・終了しません。"] },
        { title: "Override と native image", paragraphs: ["アプリケーション bean は R2D1、CollectionFactory、DocumentStore、IndexStore、initializer の順で integration が作る bean より優先されます。custom DocumentCodec は collection API に渡します。", "検証済みの native smoke path は H2 JDBC backend の Micronaut ApplicationContext です。native image の document type には @ReflectiveAccess などの明示的な reflection registration が必要になる場合があります。R2 と D1 の native runtime は現在検証済みのサポート経路ではありません。", "この module は Micronaut Data repository、HTTP endpoint、metrics、tracing、Spring compatibility、R2DBC、retry policy、database-server lifecycle を提供しません。"] }
      ],
      related: [{ label: "設定 →", href: "/docs/configuration/" }, { label: "JDBC IndexStore →", href: "/docs/index-stores/jdbc/" }]
    }
  }
};

const { locale, slug } = Astro.props;
const page = copy[locale][slug];

if (!page) {
  throw new Error(`Missing localized content for ${locale}/${slug}`);
}
---

<p>{page.intro}</p>

{page.sections.map((section) => (
  <section class="doc-subsection">
    <h2>{section.title}</h2>
    {section.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
    {section.bullets && (
      <ul>
        {section.bullets.map((bullet) => <li>{bullet}</li>)}
      </ul>
    )}
    {section.table && (
      <div class="table-scroll">
        <table>
          <thead>
            <tr>{section.table.headers.map((header) => <th>{header}</th>)}</tr>
          </thead>
          <tbody>
            {section.table.rows.map((row) => (
              <tr>{row.map((cell) => <td>{cell}</td>)}</tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
    {section.code && (
      <pre><code class={`language-${section.code.language}`}>{section.code.value}</code></pre>
    )}
  </section>
))}

{page.related && (
  <div class="docs-link-list doc-related-links">
    {page.related.map((link) => <a href={localePath(link.href, locale)}>{link.label}</a>)}
  </div>
)}
