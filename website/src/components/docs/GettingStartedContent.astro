const { locale } = Astro.props;
const c = copy[locale];
---

<p>{c.intro}</p>

<h2>{c.step1}</h2>
<p>{c.step1Body}</p>
<ul>
  {c.documentLinks.map((item) => <li>{item}</li>)}
</ul>

<h2>{c.step2}</h2>
<p>{c.step2Body}</p>
<ul>
  {c.indexLinks.map((item) => <li>{item}</li>)}
</ul>
<p>{c.pairing}</p>

<h2>{c.step3}</h2>
<p>{c.step3Body}</p>
<pre><code class="language-kotlin">{coreDependency}</code></pre>
<p>{c.optionalBody}</p>
<pre><code class="language-kotlin">{optionalDependencies}</code></pre>
<p>{c.jdbcNote} <a href={localePath("/docs/configuration/", locale)}>{c.configurationLink}</a>.</p>

<h2>{c.step4}</h2>
<p>{c.step4Body}</p>
<pre><code class="language-java">{documentExample}</code></pre>
<p>{c.codecNote}</p>

<h2>{c.step5}</h2>
<p>{c.step5Body}</p>
<pre><code class="language-java">{configurationExample}</code></pre>
<p>{c.initializeNote}</p>

<h2>{c.step6}</h2>
<pre><code class="language-java">{mutationExample}</code></pre>
<p>{c.mutationNote}</p>

<h2>{c.step7}</h2>
<pre><code class="language-java">{queryExample}</code></pre>
<p>{c.cursorNote} <a href={localePath("/docs/querying/", locale)}>{c.queryingLink}</a>{c.recoveryNote} <a href={localePath("/docs/consistency/", locale)}>{c.consistencyLink}</a>.</p>
