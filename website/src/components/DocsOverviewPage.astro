---
import SiteLayout from "../layouts/SiteLayout.astro";
import { localePath, type Locale } from "../i18n/config";
import release from "../data/release.json";

interface ModuleCard {
  label: string;
  name: string;
  coordinate: string;
  description: string;
  link: string;
  href: string;
}

interface OverviewCopy {
  seoTitle: string;
  seoDescription: string;
  eyebrow: string;
  title: string;
  intro: string;
  documentLabel: string;
  documentTitle: string;
  documentDescription: string;
  documentLinks: Array<{ label: string; href: string }>;
  indexLabel: string;
  indexTitle: string;
  indexDescription: string;
  indexLinks: Array<{ label: string; href: string }>;
  apiEyebrow: string;
  apiTitle: string;
  apiCards: Array<{ title: string; description: string; link: string; href: string }>;
  modulesEyebrow: string;
  modulesTitle: string;
  modules: ModuleCard[];
  boundaryEyebrow: string;
  boundaryTitle: string;
  boundaryDescription: string;
}

const latestStableVersion = release.latestStableVersion;

const copy: Record<Locale, OverviewCopy> = {
