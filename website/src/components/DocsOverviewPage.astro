      { label: "DOCUMENT STORE", name: "R2D1-FILESYSTEM", coordinate: "dev.nexcraft:r2d1-filesystem", description: "正規のローカルドキュメントファイル。", link: "Filesystem の設定 →", href: "/docs/document-stores/filesystem/" },
      { label: "FRAMEWORK INTEGRATION", name: "R2D1-MICRONAUT", coordinate: "dev.nexcraft:r2d1-micronaut", description: "Micronaut 5 の bean とリソース統合。", link: "Micronaut の設定 →", href: "/docs/micronaut/" },
      { label: "FRAMEWORK INTEGRATION", name: "R2D1-SPRING-BOOT-STARTER", coordinate: "dev.nexcraft:r2d1-spring-boot-starter", description: `Maven Central に公開された ${latestStableVersion} Spring Boot 4 starter と独立した auto-configuration。`, link: "Spring Boot の設定 →", href: "/docs/spring/" }
