interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = copy[locale];
---

<SiteLayout title={c.seoTitle} description={c.seoDescription} locale={locale}>
  <section class="section" aria-labelledby="docs-title">
    <div class="section-eyebrow section-eyebrow-sky">
      <span>{c.eyebrow}</span>
      <h1 id="docs-title">{c.title}</h1>
    </div>
    <p class="section-intro">{c.intro}</p>
    <div class="backend-grid">
      <article class="backend-panel backend-document">
        <div class="backend-panel-heading">
          <span>{c.documentLabel}</span>
          <h2>{c.documentTitle}</h2>
        </div>
        <p>{c.documentDescription}</p>
        <div class="docs-link-list">
          {c.documentLinks.map((link) => <a href={localePath(link.href, locale)}>{link.label}</a>)}
        </div>
      </article>
      <article class="backend-panel backend-index">
        <div class="backend-panel-heading">
          <span>{c.indexLabel}</span>
          <h2>{c.indexTitle}</h2>
        </div>
        <p>{c.indexDescription}</p>
        <div class="docs-link-list">
          {c.indexLinks.map((link) => <a href={localePath(link.href, locale)}>{link.label}</a>)}
        </div>
      </article>
    </div>
  </section>

  <section class="section" aria-labelledby="api-title">
    <div class="section-eyebrow section-eyebrow-olive">
      <span>{c.apiEyebrow}</span>
      <h2 id="api-title">{c.apiTitle}</h2>
    </div>
    <div class="docs-card-grid">
      {c.apiCards.map((card) => (
        <div class="docs-card">
          <h2>{card.title}</h2>
          <p>{card.description}</p>
          <a href={localePath(card.href, locale)}>{card.link}</a>
        </div>
      ))}
    </div>
  </section>

  <section class="section" aria-labelledby="modules-title">
    <div class="section-eyebrow section-eyebrow-salmon">
      <span>{c.modulesEyebrow}</span>
      <h2 id="modules-title">{c.modulesTitle}</h2>
    </div>
    <div class="module-grid">
      {c.modules.map((module) => (
        <article class:list={{ "module-card": true, [`module-card-${module.name.toLowerCase().replace("r2d1-", "")}`]: true }}>
          <span class="module-label">{module.label}</span>
          <h3>{module.name}</h3>
          <code>{module.coordinate}</code>
          <p>{module.description}</p>
          <a href={localePath(module.href, locale)}>{module.link}</a>
        </article>
      ))}
    </div>
  </section>

  <section class="section" aria-labelledby="doc-boundary-title">
    <div class="section-eyebrow section-eyebrow-olive">
      <span>{c.boundaryEyebrow}</span>
      <h2 id="doc-boundary-title">{c.boundaryTitle}</h2>
    </div>
    <p class="section-intro">{c.boundaryDescription}</p>
  </section>
</SiteLayout>
